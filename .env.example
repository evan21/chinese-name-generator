# Supabase Configuration
# 创建Supabase项目后可以在项目设置中找到这些信息
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Stripe Configuration
# Stripe公钥，在Stripe dashboard的API keys中找到
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# Stripe Price IDs
# 在Stripe中创建产品和价格后，将对应的Price ID填在这里
VITE_STRIPE_PRICE_PRO_MONTHLY=price_1234567890
VITE_STRIPE_PRICE_PRO_YEARLY=price_1234567890
VITE_STRIPE_PRICE_ENTERPRISE_MONTHLY=price_1234567890

# 可选：OpenAI API Key（如果需要使用AI名字分析功能）
VITE_OPENAI_API_KEY=sk-your-openai-api-key
